rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is an admin iff a doc exists at admins/{their-uid}.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admin allowlist ──
    // A signed-in user may read ONLY their own admin doc (to check status).
    // Admins are provisioned manually in the console / via Admin SDK.
    // No client writes, ever.
    match /admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Users ──
    match /users/{userId} {
      // Owner reads own doc; admins read any doc.
      allow read:          if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete:         if false;

      // ── Harvests (NFT placeholders) ──
      match /harvests/{harvestId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          resource.data.isPublic == true
        );
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete:         if false;
      }
    }

    // ── Audit logs ──
    // Written ONLY by the serverless layer (Admin SDK bypasses these rules).
    // Clients can never write. Admins may read; everyone else is denied.
    match /audit_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
